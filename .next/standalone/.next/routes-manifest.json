      "routeKeys": {},
      "namedRegex": "^/api/ai/describe(?:/)?$"
    },
    {
      "page": "/api/auth/login",
      "regex": "^/api/auth/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/login(?:/)?$"
    },
    {
      "page": "/api/auth/logout",
      "regex": "^/api/auth/logout(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/logout(?:/)?$"
    },
    {
      "page": "/api/auth/profiles",
      "regex": "^/api/auth/profiles(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/profiles(?:/)?$"
    },
    {
      "page": "/api/auth/signup",
      "regex": "^/api/auth/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/signup(?:/)?$"
    },
    {
      "page": "/api/auth/switch-profile",
      "regex": "^/api/auth/switch\\-profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/switch\\-profile(?:/)?$"
    },
    {
      "page": "/api/history",
      "regex": "^/api/history(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/history(?:/)?$"
    },
    {
      "page": "/api/movies",
      "regex": "^/api/movies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/movies(?:/)?$"
    },
    {
      "page": "/api/notifications",
      "regex": "^/api/notifications(?:/)?$",
      "routeKeys": {},
